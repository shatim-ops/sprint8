,[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=job;" vertex="1" parent="1"><mxGeometry x="385" y="620" width="26" height="26" as="geometry"/></mxCell><mxCell id="c45" value="Rate Limiter" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=8;fontColor=#1F4E79;spacing=0;" vertex="1" parent="1"><mxGeometry x="373" y="646" width="50" height="24" as="geometry"/></mxCell><mxCell id="c46" value="api-gateway (ingress): 20 RPS на партнёра" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="380" y="660" width="100" height="40" as="geometry"/></mxCell><mxCell id="c47" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=quota;" vertex="1" parent="1"><mxGeometry x="1555" y="590" width="26" height="26" as="geometry"/></mxCell><mxCell id="c48" value="Timeout" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=8;fontColor=#1F4E79;spacing=0;" vertex="1" parent="1"><mxGeometry x="1543" y="616" width="50" height="24" as="geometry"/></mxCell><mxCell id="c49" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=deploy;" vertex="1" parent="1"><mxGeometry x="1605" y="590" width="26" height="26" as="geometry"/></mxCell><mxCell id="c50" value="Retry" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=8;fontColor=#1F4E79;spacing=0;" vertex="1" parent="1"><mxGeometry x="1593" y="616" width="50" height="24" as="geometry"/></mxCell><mxCell id="c51" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=c_role;" vertex="1" parent="1"><mxGeometry x="1655" y="590" width="26" height="26" as="geometry"/></mxCell><mxCell id="c52" value="Circuit Breaker" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=8;fontColor=#1F4E79;spacing=0;" vertex="1" parent="1"><mxGeometry x="1643" y="616" width="50" height="24" as="geometry"/></mxCell><mxCell id="c53" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=quota;" vertex="1" parent="1"><mxGeometry x="1650" y="950" width="26" height="26" as="geometry"/></mxCell><mxCell id="c54" value="Timeout" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=8;fontColor=#1F4E79;spacing=0;" vertex="1" parent="1"><mxGeometry x="1638" y="976" width="50" height="24" as="geometry"/></mxCell><mxCell id="c55" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=deploy;" vertex="1" parent="1"><mxGeometry x="1700" y="950" width="26" height="26" as="geometry"/></mxCell><mxCell id="c56" value="Retry" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=8;fontColor=#1F4E79;spacing=0;" vertex="1" parent="1"><mxGeometry x="1688" y="976" width="50" height="24" as="geometry"/></mxCell><mxCell id="c57" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=quota;" vertex="1" parent="1"><mxGeometry x="1200" y="345" width="26" height="26" as="geometry"/></mxCell><mxCell id="c58" value="Timeout" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=8;fontColor=#1F4E79;spacing=0;" vertex="1" parent="1"><mxGeometry x="1188" y="371" width="50" height="24" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;Обозначения паттернов отказоустойчивости&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="300" height="190" as="geometry"/></mxCell><mxCell id="c60" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=quota;" vertex="1" parent="1"><mxGeometry x="52" y="752" width="26" height="26" as="geometry"/></mxCell><mxCell id="c61" value="Timeout: ограничение времени ожидания ответа" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="86" y="748" width="250" height="34" as="geometry"/></mxCell><mxCell id="c62" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=deploy;" vertex="1" parent="1"><mxGeometry x="52" y="790" width="26" height="26" as="geometry"/></mxCell><mxCell id="c63" value="Retry: повтор при временной ошибке, с backoff" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="86" y="786" width="250" height="34" as="geometry"/></mxCell><mxCell id="c64" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=job;" vertex="1" parent="1"><mxGeometry x="52" y="828" width="26" height="26" as="geometry"/></mxCell><mxCell id="c65" value="Rate Limiter: ограничение частоты запросов" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="86" y="824" width="250" height="34" as="geometry"/></mxCell><mxCell id="c66" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=c_role;" vertex="1" parent="1"><mxGeometry x="52" y="866" width="26" height="26" as="geometry"/></mxCell><mxCell id="c67" value="Circuit Breaker: отключение проблемного вызова" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="86" y="862" width="250" height="34" as="geometry"/></mxCell><mxCell id="c68" value="&lt;b&gt;Решения по ОСАГО&lt;/b&gt;&lt;br&gt;1. osago-aggregator получает своё хранилище: заявка живёт до 60 с, но экземпляров несколько, и кто-то должен помнить, какие страховые уже ответили, какие ещё опрашивать и когда истекает дедлайн. Таблица маленькая, строки удаляются через час.&lt;br&gt;2. API для core-app: события в Kafka (заявки внутрь, предложения наружу) плюс REST на чтение состояния заявки для случая, когда веб-клиент переподключился.&lt;br&gt;3. Веб получает предложения через SSE: односторонний поток поверх HTTP, браузер сам переподключается с Last-Event-ID; на ingress отключён буфер ответа и таймаут 90 с, больше дедлайна заявки. WebSocket здесь избыточен, polling не даёт мгновенного показа.&lt;br&gt;4. Несколько экземпляров: SSE-соединение живёт на одном поде core-app, поэтому каждый под читает osago.offers в своей consumer group и отдаёт клиенту только события своих заявок. osago-aggregator делит заявки между подами через SKIP LOCKED, вызовы к страховым идемпотентны по applicationId." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=11;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="380" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>