e;resizable=0;points=[];fontSize=11;" vertex="1" connectable="0" parent="e113"><mxGeometry x="0.75" y="0" relative="1" as="geometry"><mxPoint x="60" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e115" value="" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;jumpStyle=arc;jumpSize=8;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c59" target="c48"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="405" y="1160"/><mxPoint x="929" y="1160"/></Array></mxGeometry></mxCell><mxCell id="l116" value="5432 на sync standby (db-ro)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;" vertex="1" connectable="0" parent="e115"><mxGeometry x="-0.5" y="0" relative="1" as="geometry"><mxPoint x="0" y="10" as="offset"/></mxGeometry></mxCell><mxCell id="c117" value="" style="vsdxID=5;fillColor=none;gradientColor=none;shape=stencil(vVPLEoIgFP0aljgEVuPa6j+YRGUica6U9vdhUKk4LWzG3X0cOPdcOIilTclrgShpDOiLaGVmSsQOiFJZlQKksRFiR8TSXIMoQN+qzOU175F9dNX3/obOnSP9CUoeLktIFL8KJ4flcLZN8NhtRJiDwxsf7VwhQHjAhniCDvNONhi04UbqakSuOBQCWy6cK16MWk0rRB2U/XRKVgMlSRwl+1nyhWI+s0+Xs4KYgNvPtlBKuJvVniX4En+9yfxWVpDx2yc2+Bosl0o5fw77U0PakjMzOz4B);strokeColor=#ff5958;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;container=0;" vertex="1" parent="1"><mxGeometry x="1300" y="330" width="200" height="100" as="geometry"/></mxCell><mxCell id="c118" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;container=0;" vertex="1" parent="1"><mxGeometry x="1386.0" y="338" width="28" height="28" as="geometry"/></mxCell><mxCell id="c119" value="&lt;div style=&quot;font-size: 1px&quot;&gt;&lt;font style=&quot;font-size:11px;font-family:Arial;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;NAT Gateway&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 1px&quot;&gt;&lt;font style=&quot;font-size:11px;font-family:Arial;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;(фиксированный адрес&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 1px&quot;&gt;&lt;font style=&quot;font-size:11px;font-family:Arial;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;для белых списков)&lt;/font&gt;&lt;/div&gt;" style="verticalAlign=middle;align=center;overflow=width;vsdxID=6;fillColor=none;gradientColor=none;strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;container=0;" vertex="1" parent="1"><mxGeometry x="1304" y="370" width="192" height="56" as="geometry"/></mxCell><mxCell id="c120" value="" style="vsdxID=5;fillColor=none;gradientColor=none;shape=stencil(vVPLEoIgFP0aljgEVuPa6j+YRGUica6U9vdhUKk4LWzG3X0cOPdcOIilTclrgShpDOiLaGVmSsQOiFJZlQKksRFiR8TSXIMoQN+qzOU175F9dNX3/obOnSP9CUoeLktIFL8KJ4flcLZN8NhtRJiDwxsf7VwhQHjAhniCDvNONhi04UbqakSuOBQCWy6cK16MWk0rRB2U/XRKVgMlSRwl+1nyhWI+s0+Xs4KYgNvPtlBKuJvVniX4En+9yfxWVpDx2yc2+Bosl0o5fw77U0PakjMzOz4B);strokeColor=#ff5958;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;container=0;" vertex="1" parent="1"><mxGeometry x="1300" y="40" width="200" height="110" as="geometry"/></mxCell><mxCell id="c121" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;container=0;" vertex="1" parent="1"><mxGeometry x="1386.0" y="48" width="28" height="28" as="geometry"/></mxCell><mxCell id="c122" value="&lt;div style=&quot;font-size: 1px&quot;&gt;&lt;font style=&quot;font-size:13px;font-family:Arial;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;Системы страховых&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 1px&quot;&gt;&lt;font style=&quot;font-size:13px;font-family:Arial;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;компаний (внешние API)&lt;/font&gt;&lt;/div&gt;" style="verticalAlign=middle;align=center;overflow=width;vsdxID=6;fillColor=none;gradientColor=none;strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;container=0;" vertex="1" parent="1"><mxGeometry x="1304" y="80" width="192" height="66" as="geometry"/></mxCell><mxCell id="e123" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c117" target="c120"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l124" value="HTTPS" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;" vertex="1" connectable="0" parent="e123"><mxGeometry x="0" y="0" relative="1" as="geometry"><mxPoint x="30" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e125" value="" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c27" target="c117"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="645"/><mxPoint x="660" y="475"/><mxPoint x="1400" y="475"/></Array></mxGeometry></mxCell><mxCell id="l126" value="вызовы страховых" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;" vertex="1" connectable="0" parent="e125"><mxGeometry x="0.2" y="0" relative="1" as="geometry"><mxPoint x="0" y="-8" as="offset"/></mxGeometry></mxCell><mxCell id="e127" value="" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c41" target="c117"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1250" y="645"/><mxPoint x="1250" y="475"/><mxPoint x="1400" y="475"/></Array></mxGeometry></mxCell><mxCell id="c128" value="&lt;b&gt;1. Масштабирование&lt;/b&gt;&lt;br&gt;Приложение: горизонтально. Все сервисы stateless, живут в Kubernetes под HPA (CPU и память), node group под cluster autoscaler. Вертикальное масштабирование подов оставляю только как настройку requests/limits, оно упирается в размер узла и не даёт отказоустойчивости.&lt;br&gt;База: вертикально плюс реплики чтения. 50 ГБ данных и 10 RPS оформления это нагрузка одного инстанса с запасом на годы, поэтому увеличиваем VM при необходимости и уводим чтение каталога на sync standby и в Redis.&lt;br&gt;Зоны: две зоны для приложения и БД, третья только под кворум Patroni/etcd и асинхронную реплику. Одна зона не даёт 99,9 % (плановые работы облака в зоне уже съедают бюджет простоя 8,7 ч в год), три полных копии приложения избыточны по деньгам." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=11;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1660" y="20" width="600" height="250" as="geometry"/></mxCell><mxCell id="c129" value="&lt;b&gt;2. Kubernetes: независимые кластеры в каждой зоне, не растянутый&lt;/b&gt;&lt;br&gt;Причины: (а) отказ зоны или ошибка control plane не тянет второй кластер, домен отказа совпадает с зоной; (б) обновления версии K8s и раскатка манифестов идут по кластерам поочерёдно, вторая зона продолжает обслуживать трафик; (в) нет межзонного трафика pod-to-pod, латентность и стоимость трафика ниже. Цена решения: два целевых кластера в CI/CD (одни манифесты, ArgoCD применяет в оба) и отдельный контроль дрейфа конфигурации. Растянутый регион-кластер отверг: при потере зоны с частью control plane деградирует весь кластер, а плюс у него один, единый kubectl." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=11;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1660" y="285" width="600" height="220" as="geometry"/></mxCell><mxCell id="c130" value="&lt;b&gt;3. Балансировка и health check&lt;/b&gt;&lt;br&gt;Cloud DNS отдаёт один публичный адрес регионального ALB (TTL 60 с). ALB (L7) держит две backend-группы, по одной на зону, вес 50/50; health check GET /healthz на ingress раз в 2 с, три неудачи подряд выводят зону из балансировки за 6 с. Внутри кластера ingress-nginx балансирует на поды по readiness probe, liveness перезапускает зависшие поды. БД: internal NLB проверяет Patroni REST API, :8008/primary отвечает 200 только на лидере, :8008/sync только на синхронной реплике, поэтому запись всегда идёт в текущий primary, а чтение на не отстающую реплику, без правок в приложении. Партнёрский API заходит через тот же ALB на api-gateway с лимитом на партнёра (20 RPS по договору), проблема одного партнёра на 250 RPS закрывается здесь." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=11;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1660" y="520" width="600" height="215" as="geometry"/></mxCell><mxCell id="c131" value="&lt;b&gt;4. Failover-стратегия: active-active по зонам&lt;/b&gt;&lt;br&gt;Клиент видит один домен. Обе зоны обслуживают запросы одновременно, сессии в JWT, состояние только в БД и Redis, поэтому любой запрос может уйти в любую зону. Отказ зоны: ALB убирает её backend-группу по health check за 6 с, при 50 RPS это до 300 запросов в мёртвую зону, ретрай на стороне веб-приложения их скрывает. Отказ primary БД: Patroni за 30 до 60 с продвигает sync standby, NLB переключает :8008/primary, приложение переподключается по тому же адресу. Запись недоступна примерно минуту, чтение продолжается с реплики. При потере зоны B с sync standby Patroni (synchronous_mode без strict) переводит запись в async и назначает синхронной ноду в зоне D. Это укладывается в RTO 45 мин с большим запасом, а синхронная реплика даёт RPO 0 при отказе одного узла." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=11;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1660" y="750" width="600" height="225" as="geometry"/></mxCell><mxCell id="c132" value="&lt;b&gt;5. База данных и резервное копирование&lt;/b&gt;&lt;br&gt;Patroni-кластер из трёх нод PostgreSQL 16 на VM в трёх зонах: primary в A, sync standby в B, async standby в D. DCS это etcd по одной ноде на каждой VM, кворум 2 из 3 переживает потерю любой зоны. Бэкапы: WAL-G с async-реплики (archive_mode=always, не грузим primary), сегмент WAL закрывается не реже раза в минуту (archive_timeout=60 на primary), базовый бэкап раз в сутки, хранение 30 дней. RPO при потере всего кластера: лаг async-реплики плюс минута, алерт на лаг больше 5 мин, против требуемых 15. RTO при полном восстановлении: VM и Patroni из Terraform, 50 ГБ из Object Storage за 15 до 25 мин, плюс переключение приложения, итого до 35 мин против 45. Восстановление проверяем ежемесячно на отдельной VM.&lt;br&gt;&lt;b&gt;6. Шардирование: не применяю.&lt;/b&gt; Объём 50 ГБ и профиль нагрузки не требуют его даже после кампании; шардирование добавит межшардовые запросы, сложность миграций и второй уровень failover. Вернуться к вопросу при росте к 1 ТБ или к тысячам RPS записи." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=11;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1660" y="990" width="600" height="340" as="geometry"/></mxCell><mxCell id="c133" value="&lt;font color=&quot;#2E7D32&quot;&gt;- - -&lt;/font&gt; health check&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#7B1FA2&quot;&gt;&amp;#9644;&amp;#9644;&lt;/font&gt; репликация и бэкапы&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#9E9E9E&quot;&gt;&amp;#183;&amp;#183;&amp;#183;&lt;/font&gt; мониторинг" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1335" width="700" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>