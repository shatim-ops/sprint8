fset"/></mxGeometry></mxCell><mxCell id="e104" value="" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;jumpStyle=arc;jumpSize=8;strokeColor=#7B1FA2;fontColor=#7B1FA2;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c34" target="c56"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="563" y="1112"/><mxPoint x="1509" y="1112"/></Array></mxGeometry></mxCell><mxCell id="l105" value="асинхронная репликация" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;" vertex="1" connectable="0" parent="e104"><mxGeometry x="0.4" y="0" relative="1" as="geometry"><mxPoint x="0" y="-8" as="offset"/></mxGeometry></mxCell><mxCell id="e106" value="" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;jumpStyle=arc;jumpSize=8;strokeColor=#7B1FA2;fontColor=#7B1FA2;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c56" target="c62"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1443" y="1155"/><mxPoint x="810" y="1155"/></Array></mxGeometry></mxCell><mxCell id="l107" value="WAL-G: WAL раз в 60 с, базовый бэкап ежедневно в 03:00" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;" vertex="1" connectable="0" parent="e106"><mxGeometry x="0.6" y="0" relative="1" as="geometry"><mxPoint x="0" y="10" as="offset"/></mxGeometry></mxCell><mxCell id="e108" value="" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c27" target="c65"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="825"/><mxPoint x="660" y="1170"/><mxPoint x="1100" y="1170"/></Array></mxGeometry></mxCell><mxCell id="e109" value="" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;font